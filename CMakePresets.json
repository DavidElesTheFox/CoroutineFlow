{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "dev-g++",
            "displayName": "Developement Config g++",
            "description": "Developement build config",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-g++/debug",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": "TRUE"
                },
                "CF_BUILD_EXAMPLES": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CF_BUILD_TESTS": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CMAKE_BUILD_TYPE": "Debug",
                "CF_COMPILE_OPTIONS": "-O1;-g"
            }
        },
        {
            "name": "dev-clang",
            "displayName": "Developement Config clang",
            "description": "Developement build config",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-clang/debug",
            "toolchainFile": "${sourceDir}/cmake/clang_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": "TRUE"
                },
                "CF_BUILD_EXAMPLES": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CF_BUILD_TESTS": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CMAKE_BUILD_TYPE": "Debug",
                "CF_COMPILE_OPTIONS": "-O1;-g"
            }
        },
        {
            "name": "dev-g++-release",
            "displayName": "Developement Config g++ Release",
            "description": "Developement build config Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-g++/release",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": "TRUE"
                },
                "CF_BUILD_EXAMPLES": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CF_BUILD_TESTS": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CMAKE_BUILD_TYPE": "Release",
                "CF_COMPILE_OPTIONS": "-O3"
            }
        },
        {
            "name": "dev-clang-release",
            "displayName": "Developement Config clang Release",
            "description": "Developement build config Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-clang/release",
            "toolchainFile": "${sourceDir}/cmake/clang_toolchain.cmake",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": "TRUE"
                },
                "CF_BUILD_EXAMPLES": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CF_BUILD_TESTS": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CMAKE_BUILD_TYPE": "Debug",
                "CF_COMPILE_OPTIONS": "-O3"
            }
        },
        {
            "name": "dev-clang-undef-sanitizer",
            "displayName": "Developement Config clang Undefined behavior sanitizer",
            "description": "Developement build config with Undefined behavior sanitizer",
            "binaryDir": "${sourceDir}/build-clang/undef-sanitizer",
            "inherits": "dev-clang",
            "cacheVariables": {
                "CF_COMPILE_OPTIONS": "-O1;-g;-fsanitize=undefined",
                "CF_LINK_OPTIONS": "-fsanitize=undefined"
            }
        },
        {
            "name": "dev-clang-memory-sanitizer",
            "displayName": "Developement Config clang memory sanitizer",
            "description": "Developement build config with memory sanitizer",
            "binaryDir": "${sourceDir}/build-clang/memory-sanitizer",
            "inherits": "dev-clang",
            "cacheVariables": {
                "CF_COMPILE_OPTIONS": "-O1;-g;-fsanitize=memory",
                "CF_LINK_OPTIONS": "-fsanitize=memory"
            }
        },
        {
            "name": "dev-clang-coverage",
            "displayName": "Developement Config clang with coverage",
            "description": "Developement build with code coverage support",
            "inherits": "dev-clang",
            "binaryDir": "${sourceDir}/build-clang/coverage",
            "cacheVariables": {
                "CF_COMPILE_OPTIONS": "-O1;-g;-fprofile-instr-generate;-fcoverage-mapping",
                "CF_LINK_OPTIONS": "-fprofile-instr-generate"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev-g++-build",
            "configurePreset": "dev-g++",
            "configuration": "Debug"
        },
        {
            "name": "dev-g++-release-build",
            "configurePreset": "dev-g++-release",
            "configuration": "Release"
        },
        {
            "name": "dev-clang-build",
            "configurePreset": "dev-clang",
            "configuration": "Debug"
        },
        {
            "name": "dev-clang-release-build",
            "configurePreset": "dev-clang-release",
            "configuration": "Release"
        },
        {
            "name": "dev-clang-undef-sanitizer-build",
            "configurePreset": "dev-clang-undef-sanitizer",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "test-g++-debug",
            "configurePreset": "dev-g++",
            "displayName": "Test Debug [g++]"
        },
        {
            "name": "test-g++-release",
            "configurePreset": "dev-g++-release",
            "displayName": "Test Debug [g++]"
        },
        {
            "name": "test-clang-debug",
            "configurePreset": "dev-clang",
            "displayName": "Test Debug [g++]"
        },
        {
            "name": "test-clang-release",
            "configurePreset": "dev-clang-release",
            "displayName": "Test Debug [g++]"
        },
        {
            "name": "test-clang-undef-sanitizer",
            "configurePreset": "dev-clang-undef-sanitizer",
            "displayName": "Test Debug [g++]"
        }
    ]
}